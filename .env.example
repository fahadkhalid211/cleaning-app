# Copy to .env.local for local development, or add each line as an
# Environment Variable in Hostinger (hPanel → your Node.js app → Environment variables).

# Site URL
NEXT_PUBLIC_APP_URL=https://hoodie.services

# First admin account. Created/synced automatically on start.
ADMIN_NAME=Hoodie
ADMIN_EMAIL=itsfahad9@gmail.com
ADMIN_PASSWORD=your-admin-password

# Where the SQLite database lives. Keep it OUTSIDE the deployed app folder so
# GitHub redeploys never wipe it. Default in production: ~/hoodie-data/hoodie.db
# DATABASE_PATH=/home/u123456789/hoodie-data/hoodie.db

# Number of proxies in front of the app (used to read the real visitor IP for rate limiting).
# Hostinger: 1. Add 1 if you also put Cloudflare or Hostinger CDN in front.
TRUSTED_PROXY_HOPS=1

# PayPal Business (REST app credentials from developer.paypal.com)
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
# "live" for real payments, "sandbox" for testing
PAYPAL_ENV=live
# Webhook ID of the webhook pointing to https://hoodie.services/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=...
DEPOSIT_PERCENT=20

# Development only: create two demo cleaners so you can test bookings straight away.
# SEED_DEMO_CLEANERS=true
# DEMO_CLEANER_PASSWORD=pick-a-test-password
